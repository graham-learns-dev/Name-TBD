{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formcheck:rule-flags:1.0",
  "title": "Rule-engine flag output (contracts/rule-engine.md)",
  "type": "object",
  "required": [
    "schema_version", "clip_id", "lift", "rep", "rep_quality_score", "flags", "skipped_rules"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "clip_id": { "type": "string" },
    "lift": { "enum": ["squat", "bench", "deadlift"] },
    "rep": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["start_ms", "bottom_ms", "end_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "bottom_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "rep_quality_score": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue", "severity", "frame_index", "timestamp_ms",
          "measured", "threshold", "unit", "description", "viz"
        ],
        "properties": {
          "issue": {
            "enum": [
              "insufficient_depth", "knee_valgus", "back_rounding", "bar_drift",
              "bar_path_deviation", "no_rep_detected", "view_check_failed"
            ]
          },
          "severity": { "enum": ["low", "medium", "high", "info"] },
          "frame_index": { "type": "integer", "minimum": 0 },
          "timestamp_ms": { "type": "integer", "minimum": 0 },
          "measured": { "type": "number" },
          "threshold": { "type": "number" },
          "unit": { "type": "string" },
          "description": { "type": "string", "maxLength": 60 },
          "viz": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["type", "keypoints", "style"],
                "properties": {
                  "type": { "enum": ["angle", "line", "path", "marker"] },
                  "keypoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  },
                  "style": { "enum": ["warning", "fault", "neutral"] }
                }
              }
            ]
          }
        }
      }
    },
    "skipped_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "reason"],
        "properties": {
          "issue": { "type": "string" },
          "reason": { "enum": ["low_confidence", "view_check_failed"] }
        }
      }
    }
  }
}
